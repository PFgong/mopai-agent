# 复制为 .env 后修改。.env 已被 .gitignore 忽略，请勿提交真实密钥。

# Agent 接口鉴权令牌。前端每次请求都在 X-Agent-Token 头中携带此值。
# 生成方式：openssl rand -hex 32   或   python -c "import secrets;print(secrets.token_urlsafe(32))"
# 留空会导致所有接口返回 503。
AGENT_TOKEN=replace-with-a-long-random-secret

# 允许访问 Agent 的网页来源，逗号分隔，必须写完整协议与端口。
# 本地默认用 http://localhost:8080；换成你自己的工作台地址。
ALLOWED_ORIGINS=http://localhost:8080

# 编译容器的共享令牌。Agent 与 compiler 必须使用同一个值。
# 生成方式同上。留空则编译容器不校验调用方（仅限完全隔离的内网环境）。
COMPILER_TOKEN=replace-with-another-long-random-secret

# 以下两项仅在免 Docker 的本机部署中可能需要：
# 若 pandoc / latexmk 不在 PATH（例如绿色版 MiKTeX），在这里写完整路径即可。
# PANDOC_PATH=C:\Program Files\Pandoc\pandoc.exe
# LATEXMK_BIN=D:\tex\miktex\bin\x64\latexmk.exe
